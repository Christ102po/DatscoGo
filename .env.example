# Web can leave VITE_API_BASE_URL blank when frontend and Express are on the same Render service.
# Android/Capacitor MUST use the public HTTPS Render service URL.
VITE_API_BASE_URL=https://YOUR-DATSCOGO-SERVICE.onrender.com
VITE_OSRM_URL=https://router.project-osrm.org

# Render server environment variables (set these in Render, not in client-side .env files):
# ADMIN_KEY=YOUR_PRIVATE_ADMIN_KEY
# DATSCO_DATA_FILE=/data/datscogo.json
