# Copy to .env for LOCAL testing only. Never commit .env or publish secrets.
# Paste the complete PostgreSQL connection string from Neon > Connect.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DATABASE?sslmode=require

# On first database initialization, use your own strong credentials.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_STRONG_PASSWORD

PORT=3000
NODE_ENV=development
